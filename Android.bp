soong_namespace {
}

android_app_import {
    name: "daxService",
    owner: "oneplus",
    apk: "proprietary/system_ext/priv-app/daxService/daxService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

android_app_import {
    name: "DaxUI",
    owner: "oneplus",
    apk: "proprietary/system_ext/priv-app/DaxUI/DaxUI.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    overrides: [
        "MusicFX",
        "AudioFX",
    ],
}

cc_prebuilt_binary {
    name: "vendor.dolby.hardware.dms@2.0-service",
    owner: "oneplus",
    srcs: ["proprietary/vendor/bin/hw/vendor.dolby.hardware.dms@2.0-service"],
    strip: {
        none: true,
    },
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/vendor/lib/libdapparamstorage.so"],
        },
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/libdapparamstorage.so"],
        },
    },
    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
    ],
    vendor: true,
}

